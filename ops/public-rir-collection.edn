{:cell "ipaddress_ingest"
 :cron "7 * * * *"
 :source :rir-delegated-stats
 :rirs ["apnic" "ripe" "arin" "lacnic" "afrinic"]
 :runner {:module "kotoba.lang.internet-intel.collector"
          :entry "collect-rir!"
          :timeout-seconds 600}
 :storage "data/public-rir.datoms.kotoba.edn"
 :dedup :content-cid
 :notification {:endpoint-env "MURAKUMO_COLLECTION_RECEIPT_URL"
                :required false
                :payload [":rir" ":observations" ":appended?" ":datoms" ":cid"]}}
